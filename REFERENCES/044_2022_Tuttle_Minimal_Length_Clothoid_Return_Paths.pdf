<rdf:Description rdf:about="">
<dc:identifier></dc:identifier>
<dc:title>Minimal length multi-segment clothoid return paths for vehicles with turn rate constraints</dc:title>
<prism:doi></prism:doi>
<prism:url></prism:url>
<dc:creator><rdf:Bag><rdf:li>Theodore Tuttle</rdf:li>
<rdf:li>Jay P. Wilhelm</rdf:li>
</rdf:Bag></dc:creator>
<dc:description>Continuous curvature recovery paths are needed to accurately return a fixed wing autonomous vehicle with turn rate constraints back to a missions path in the correct direction after collision avoidance.</dc:description>
<dc:subject><rdf:Bag><rdf:li>clothoid</rdf:li><rdf:li>optimization</rdf:li><rdf:li>path interception</rdf:li><rdf:li>path recovery</rdf:li><rdf:li>fixed wing aircraft</rdf:li></rdf:Bag></dc:subject>
