<?xml version="1.0"?>
<sdf version="1.9">
  <world name="research_warehouse">
    <physics name="research_physics" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.18 0.22 0.28 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1.0</direction>
    </light>

    <model name="research_layout">
      <static>true</static>
      <link name="layout_link">
        <collision name="floor_collision">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>12.0 8.0 0.05</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>12.0 8.0 0.05</size></box></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material>
        </visual>

        <collision name="wall_north"><pose>0 3.95 0.5 0 0 0</pose><geometry><box><size>12 0.10 1.0</size></box></geometry></collision>
        <visual name="wall_north_visual"><pose>0 3.95 0.5 0 0 0</pose><geometry><box><size>12 0.10 1.0</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
        <collision name="wall_south"><pose>0 -3.95 0.5 0 0 0</pose><geometry><box><size>12 0.10 1.0</size></box></geometry></collision>
        <visual name="wall_south_visual"><pose>0 -3.95 0.5 0 0 0</pose><geometry><box><size>12 0.10 1.0</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
        <collision name="wall_west"><pose>-5.95 0 0.5 0 0 0</pose><geometry><box><size>0.10 8 1.0</size></box></geometry></collision>
        <visual name="wall_west_visual"><pose>-5.95 0 0.5 0 0 0</pose><geometry><box><size>0.10 8 1.0</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
        <collision name="wall_east"><pose>5.95 0 0.5 0 0 0</pose><geometry><box><size>0.10 8 1.0</size></box></geometry></collision>
        <visual name="wall_east_visual"><pose>5.95 0 0.5 0 0 0</pose><geometry><box><size>0.10 8 1.0</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>

        <collision name="rack_a"><pose>-1.0 1.4 0.6 0 0 0</pose><geometry><box><size>0.60 3.60 1.20</size></box></geometry></collision>
        <visual name="rack_a_visual"><pose>-1.0 1.4 0.6 0 0 0</pose><geometry><box><size>0.60 3.60 1.20</size></box></geometry><material><ambient>0.15 0.30 0.65 1</ambient><diffuse>0.18 0.38 0.80 1</diffuse></material></visual>
        <collision name="rack_b"><pose>2.3 -1.2 0.6 0 0 0</pose><geometry><box><size>3.20 0.60 1.20</size></box></geometry></collision>
        <visual name="rack_b_visual"><pose>2.3 -1.2 0.6 0 0 0</pose><geometry><box><size>3.20 0.60 1.20</size></box></geometry><material><ambient>0.15 0.30 0.65 1</ambient><diffuse>0.18 0.38 0.80 1</diffuse></material></visual>
        <collision name="rack_c"><pose>4.3 1.9 0.6 0 0 0</pose><geometry><box><size>0.60 2.80 1.20</size></box></geometry></collision>
        <visual name="rack_c_visual"><pose>4.3 1.9 0.6 0 0 0</pose><geometry><box><size>0.60 2.80 1.20</size></box></geometry><material><ambient>0.15 0.30 0.65 1</ambient><diffuse>0.18 0.38 0.80 1</diffuse></material></visual>
        <collision name="crate"><pose>-3.6 -1.8 0.5 0 0 0</pose><geometry><box><size>1.00 1.00 1.00</size></box></geometry></collision>
        <visual name="crate_visual"><pose>-3.6 -1.8 0.5 0 0 0</pose><geometry><box><size>1.00 1.00 1.00</size></box></geometry><material><ambient>0.55 0.28 0.08 1</ambient><diffuse>0.72 0.38 0.10 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
